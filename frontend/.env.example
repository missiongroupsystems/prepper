# Copy to .env.local and fill in. Server-only keys never get a NEXT_PUBLIC_ prefix.

# Backend API base (FastAPI, routes under /api/v1)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (anon key only; the service key stays on the backend)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Deployment tier for the environment badge: production | staging | preview | local.
# Leave unset locally (shows LOCAL). On Vercel set it per environment; unset there shows ENV UNSET.
NEXT_PUBLIC_APP_ENV=

# Tasting invitations — SMS degrades to email-only when Twilio is unset
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SENDGRID_API_KEY=
SENDER_EMAIL=
SENDER_NAME=

# Lark integration
LARK_APP_ID=
LARK_APP_SECRET=
